lower { label = "LOWER"; bindings = <&kp N5 &kp N4 &kp N3 &kp N2 &kp N1 &trans &kp F5 &kp F4 &kp F3 &kp F2 &kp F1 &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &trans &trans &trans &trans &trans &trans &trans &kp HOME &kp PG_DN &kp PG_UP &kp END &trans>; };
raise { label = "RAISE"; bindings = <&trans &trans &trans &trans &trans &sys_reset &trans &trans &trans &trans &trans &bootloader &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans>; };
}; };
